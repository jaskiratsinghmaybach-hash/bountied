@@ -0,0 +1,82 @@
+-- Bountied Desktop device pairing (see docs/desktop-pairing.md).
+
+-- CreateTable
+CREATE TABLE "DevicePairing" (
+    "id" TEXT NOT NULL,
+    "codeChallenge" TEXT NOT NULL,
+    "deviceName" TEXT NOT NULL,
+    "platform" TEXT NOT NULL,
+    "appVersion" TEXT NOT NULL,
+    "startIp" TEXT,
+    "userId" TEXT,
+    "codeHash" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "expiresAt" TIMESTAMP(3) NOT NULL,
+    "authorizedAt" TIMESTAMP(3),
+    "codeExpiresAt" TIMESTAMP(3),
+    "consumedAt" TIMESTAMP(3),
+    "failedAttempts" INTEGER NOT NULL DEFAULT 0,
+
+    CONSTRAINT "DevicePairing_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateTable
+CREATE TABLE "DeviceSession" (
+    "id" TEXT NOT NULL,
+    "userId" TEXT NOT NULL,
+    "deviceName" TEXT NOT NULL,
+    "platform" TEXT NOT NULL,
+    "appVersion" TEXT NOT NULL,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "lastSeenAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "lastIp" TEXT,
+    "accessTokenHash" TEXT NOT NULL,
+    "accessExpiresAt" TIMESTAMP(3) NOT NULL,
+    "refreshTokenHash" TEXT NOT NULL,
+    "prevRefreshTokenHashes" TEXT[] DEFAULT ARRAY[]::TEXT[],
+    "refreshExpiresAt" TIMESTAMP(3) NOT NULL,
+    "absoluteExpiresAt" TIMESTAMP(3) NOT NULL,
+    "revokedAt" TIMESTAMP(3),
+    "revokedReason" TEXT,
+
+    CONSTRAINT "DeviceSession_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateTable
+CREATE TABLE "RateLimitBucket" (
+    "key" TEXT NOT NULL,
+    "count" INTEGER NOT NULL,
+    "resetAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "RateLimitBucket_pkey" PRIMARY KEY ("key")
+);
+
+-- CreateIndex
+CREATE UNIQUE INDEX "DevicePairing_codeHash_key" ON "DevicePairing"("codeHash");
+
+-- CreateIndex
+CREATE INDEX "DevicePairing_userId_idx" ON "DevicePairing"("userId");
+
+-- CreateIndex
+CREATE INDEX "DevicePairing_expiresAt_idx" ON "DevicePairing"("expiresAt");
+
+-- CreateIndex
+CREATE UNIQUE INDEX "DeviceSession_accessTokenHash_key" ON "DeviceSession"("accessTokenHash");
+
+-- CreateIndex
+CREATE UNIQUE INDEX "DeviceSession_refreshTokenHash_key" ON "DeviceSession"("refreshTokenHash");
+
+-- CreateIndex
+CREATE INDEX "DeviceSession_userId_revokedAt_idx" ON "DeviceSession"("userId", "revokedAt");
+
+-- CreateIndex
+CREATE INDEX "DeviceSession_prevRefreshTokenHashes_idx" ON "DeviceSession" USING GIN ("prevRefreshTokenHashes");
+
+-- CreateIndex
+CREATE INDEX "RateLimitBucket_resetAt_idx" ON "RateLimitBucket"("resetAt");
+
+-- AddForeignKey
+ALTER TABLE "DevicePairing" ADD CONSTRAINT "DevicePairing_userId_fkey" FOREIGN KEY ("userId") REFERENCES "User"("id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "DeviceSession" ADD CONSTRAINT "DeviceSession_userId_fkey" FOREIGN KEY ("userId") REFERENCES "User"("id") ON DELETE CASCADE ON UPDATE CASCADE;
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index c74e287..9bd85e0 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -40,6 +40,8 @@ model User {
   badges              UserBadge[]
   notificationsReceived Notification[] @relation("NotificationRecipient")
   notificationsSent   Notification[]  @relation("NotificationSender")
+  deviceSessions      DeviceSession[]
+  devicePairings      DevicePairing[]
 
   @@index([email])
 }
@@ -357,3 +359,66 @@ enum SubmissionStatus {
   // paid sandbox execution in api/sandbox/run/route.ts.
   MIRRORING
 }
+
+// ── Bountied Desktop device pairing (docs/desktop-pairing.md) ──────────────
+// The website is the account authority. A Desktop app starts a pairing
+// request, the signed-in user authorizes it in the browser, the website
+// issues a single-use 16-char code, and the app exchanges that code (plus a
+// PKCE verifier) for a revocable device session. Secrets are stored only as
+// HMAC-SHA256 hashes; plaintext codes/tokens are never persisted.
+
+model DevicePairing {
+  id             String    @id // 128-bit random, base64url: the "device request id"
+  codeChallenge  String // base64url(SHA-256(code_verifier)); the verifier never leaves the app
+  deviceName     String
+  platform       String
+  appVersion     String
+  startIp        String?
+  userId         String? // set when the signed-in user authorizes
+  codeHash       String?   @unique // HMAC of the one-time code (never the code itself)
+  createdAt      DateTime  @default(now())
+  expiresAt      DateTime // whole request dies here (~5 min)
+  authorizedAt   DateTime?
+  codeExpiresAt  DateTime? // the code dies here (<= expiresAt)
+  consumedAt     DateTime? // single use: set atomically on successful exchange
+  failedAttempts Int       @default(0)
+  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  @@index([userId])
+  @@index([expiresAt])
+}
+
+model DeviceSession {
+  id                   String    @id @default(cuid())
+  userId               String
+  deviceName           String
+  platform             String
+  appVersion           String
+  createdAt            DateTime  @default(now())
+  lastSeenAt           DateTime  @default(now())
+  lastIp               String?
+  accessTokenHash      String    @unique
+  accessExpiresAt      DateTime // short-lived (~15 min)
+  refreshTokenHash     String    @unique
+  // Hashes of refresh tokens this session has already rotated away from (bounded to the
+  // most recent 100). Presenting one of these again = replay = likely theft -> revoke.
+  prevRefreshTokenHashes String[] @default([])
+  refreshExpiresAt     DateTime // sliding
+  absoluteExpiresAt    DateTime // hard cap: the device must re-pair after this
+  revokedAt            DateTime?
+  revokedReason        String?
+  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  @@index([userId, revokedAt])
+  @@index([prevRefreshTokenHashes], type: Gin)
+}
+
+// Fixed-window counters for pairing/refresh abuse limits. DB-backed because
+// the web app runs on serverless instances with no shared memory.
+model RateLimitBucket {
+  key     String   @id
+  count   Int
+  resetAt DateTime
+
+  @@index([resetAt])
+}
diff --git a/src/app/(app)/desktop/connect/page.tsx b/src/app/(app)/desktop/connect/page.tsx
new file mode 100644
index 0000000..4e39416
--- /dev/null
+++ b/src/app/(app)/desktop/connect/page.tsx
@@ -0,0 +1,68 @@
+import { redirect } from "next/navigation";
+import { headers } from "next/headers";
+import { createClient } from "@/lib/supabase/server";
+import { prisma } from "@/lib/db";
+import { getPairingForReview } from "@/lib/desktop/pairing";
+import { clientIp } from "@/lib/desktop/ratelimit";
+import { AuthorizeCard } from "@/components/desktop/authorize-card";
+
+export const dynamic = "force-dynamic";
+
+const NOT_VALID =
+  "This connection request is no longer valid. Open Bountied Desktop and choose Connect to start again.";
+
+export default async function ConnectDesktopPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ req?: string }>;
+}) {
+  const { req } = await searchParams;
+
+  const supabase = await createClient();
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) {
+    const back = `/desktop/connect?req=${encodeURIComponent(req ?? "")}`;
+    redirect(`/login?redirectedFrom=${encodeURIComponent(back)}`);
+  }
+  const profile = await prisma.user.findUnique({ where: { id: user.id } });
+  if (!profile) redirect("/login");
+  if (!profile.role) redirect("/onboarding");
+
+  const pairing = req ? await getPairingForReview(req, profile.id) : null;
+  const usable = pairing && !pairing.consumedAt && pairing.expiresAt > new Date();
+  const alreadyIssued = usable && pairing.userId === profile.id && pairing.authorizedAt;
+
+  // Helps the user spot a request that did not originate on their own machine.
+  const browserIp = clientIp(await headers());
+  const differentNetwork = Boolean(pairing?.startIp && browserIp !== "unknown" && pairing.startIp !== browserIp);
+
+  return (
+    <main className="flex-1 flex items-center justify-center px-6 py-16">
+      <div className="w-full max-w-md">
+        {!usable ? (
+          <div className="rounded-lg border border-border bg-surface p-6">
+            <h1 className="text-lg font-semibold tracking-tight mb-2">Request not available</h1>
+            <p className="text-sm text-foreground-muted">{NOT_VALID}</p>
+          </div>
+        ) : alreadyIssued ? (
+          <div className="rounded-lg border border-border bg-surface p-6">
+            <h1 className="text-lg font-semibold tracking-tight mb-2">Code already generated</h1>
+            <p className="text-sm text-foreground-muted">
+              For your security a code is shown only once. If you didn&apos;t copy it, return to Bountied
+              Desktop and choose Connect to start a new request.
+            </p>
+          </div>
+        ) : (
+          <AuthorizeCard
+            pairingId={pairing.id}
+            account={{ name: profile.name, email: profile.email }}
+            device={{ name: pairing.deviceName, platform: pairing.platform, appVersion: pairing.appVersion }}
+            requestedAt={pairing.createdAt.toISOString()}
+            requestExpiresAt={pairing.expiresAt.toISOString()}
+            differentNetwork={differentNetwork}
+          />
+        )}
+      </div>
+    </main>
+  );
+}
