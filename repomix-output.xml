@import "tailwindcss";

:root {
  /* Ink-navy base — warmer and more distinctive than pure black */
  --background: #0b0f1a;
  --surface: #121826;
  --surface-raised: #1a2233;
  --foreground: #e8ecf4;
  --foreground-muted: #8b93a7;
  --border: #232b3d;

  /* Signal accent — active bounty / money-on-the-table cue */
  --accent: #c4f135;
  --accent-dim: #8fb02a;

  /* Reserved exclusively for escrow / payment states */
  --money: #ffb020;
  --money-dim: #b3821a;

  --danger: #ff5c5c;
}

@theme inline {
  --color-background: var(--background);
  --color-surface: var(--surface);
  --color-surface-raised: var(--surface-raised);
  --color-foreground: var(--foreground);
  --color-foreground-muted: var(--foreground-muted);
  --color-border: var(--border);
  --color-accent: var(--accent);
  --color-accent-dim: var(--accent-dim);
  --color-money: var(--money);
  --color-money-dim: var(--money-dim);
  --color-danger: var(--danger);
  --font-sans: var(--font-inter);
  --font-mono: var(--font-mono-display);
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans), system-ui, sans-serif;
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/*
 * Universal scrollbar styling — applies to every scrollable element on
 * the site (the page itself, any overflow-y-auto/overflow-x-auto
 * container, <pre> blocks like captured sandbox output, modals, etc.)
 * with zero per-component work. Set once here, never needed again.
 *
 * Two rule sets are required for real cross-browser coverage:
 *   - scrollbar-color / scrollbar-width: the current CSS standard,
 *     supported by Firefox and modern Chrome/Edge (111+).
 *   - ::-webkit-scrollbar and friends: still needed for full styling
 *     control (hover states, corner) in WebKit/Blink browsers, since
 *     their support for the standard properties alone is coarser.
 * Applying both to `*` means no element needs individual opt-in.
 */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background-color: var(--border);
  border-radius: 0;
}

*::-webkit-scrollbar-thumb:hover {
  background-color: var(--foreground-muted);
}

*::-webkit-scrollbar-corner {
  background: transparent;
}

/* Hide the default up/down (or left/right) arrow buttons at each end of
   the scrollbar track — WebKit renders these unless explicitly zeroed out. */
*::-webkit-scrollbar-button {
  display: none;
  width: 0;
  height: 0;
}
