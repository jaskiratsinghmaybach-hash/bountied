  }

  return (
    <div className="flex-1 min-h-0 flex">
      <DashboardSidebar role={role} />
      <div className="flex-1 min-w-0 overflow-y-auto flex flex-col">
        <OAuthFragmentHandler />
        {children}
      </div>
    </div>
  );
}
