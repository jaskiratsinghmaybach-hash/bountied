// Prisma schema for the bounty/challenge platform
// Connection URLs live in prisma.config.ts (Prisma 7+), not here.
// Run `npx prisma generate` then `npx prisma migrate dev --name init` after setting up .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core Users ──────────────────────────────────────────────────────────

enum UserRole {
  SOLVER
  GIVER
  BOTH
}

model User {
  // This id is NOT generated by Prisma — it must match Supabase Auth's
  // auth.users.id exactly (a UUID). Set explicitly when the row is created
  // by the auth sync step in src/lib/auth/sync-user.ts, never auto-generated.
  id               String   @id
  email            String   @unique
  role             UserRole?  // null until they complete onboarding
  name             String
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Verification — kept lightweight per product decision (bank + basic identity only)
  bankVerified     Boolean  @default(false)
  identityVerified Boolean  @default(false)

  // Payment provider identity — generic so Whop -> Stripe swap doesn't touch schema
  paymentProviderId   String? // e.g. Whop user id now, Stripe customer id later
  paymentProviderType String  @default("whop") // "whop" | "stripe"

  // Reputation
  rating           Float    @default(0)
  totalEarned      Decimal  @default(0) @db.Decimal(12, 2)
  completionCount  Int      @default(0)
  accuracyRate     Float?   // nullable until they have enough completions to compute one

  // Relations
  problemsPosted   Problem[]      @relation("ProblemGiver")
  submissions      Submission[]
  badges           UserBadge[]
  reviewsGiven     Review[]       @relation("ReviewsGiven")
  reviewsReceived  Review[]       @relation("ReviewsReceived")

  @@index([email])
}

// ─── Problems / Challenges ──────────────────────────────────────────────

enum ProblemType {
  OPEN_FREE       // no bounty, practice-only
  OPEN_BOUNTY     // open to all, bounty attached
  FIRST_TO_SOLVE  // paid only, but framed as a race — giver still picks best among submissions
  INVITE_ONLY     // giver invites specific solvers by rating/badge
  FIXED_PRICE     // enterprise — COMING SOON in v1, not enabled for creation
}

enum ProblemStatus {
  DRAFT       // being written, not yet funded
  FUNDED      // escrow funded, not yet visible/open
  OPEN        // visible, accepting submissions
  IN_REVIEW   // giver is reviewing submissions (open challenges can stay OPEN during review per product decision)
  COMPLETED   // a submission was accepted, escrow released
  CANCELLED   // giver cancelled before funding or before any submissions
  REFUNDED    // funded but cancelled/expired, escrow refunded
}

model Problem {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  tags          String[]
  type          ProblemType
  status        ProblemStatus @default(DRAFT)

  bountyAmount  Decimal?      @db.Decimal(12, 2) // null for OPEN_FREE
  currency      String        @default("USD")

  giverId       String
  giver         User          @relation("ProblemGiver", fields: [giverId], references: [id])

  escrow        Escrow?

  deadline      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  // INVITE_ONLY targeting — list of invited solver user ids
  inviteeIds    String[]      @default([])

  submissions   Submission[]

  @@index([status, type])
  @@index([giverId])
}

// ─── Escrow — the trust core of the platform ────────────────────────────

enum EscrowState {
  PENDING    // created, awaiting payment capture
  HELD       // funds captured and held by platform
  RELEASED   // funds paid out to a solver
  REFUNDED   // funds returned to giver
  DISPUTED   // manual intervention needed
}

model Escrow {
  id                     String      @id @default(cuid())
  problemId              String      @unique
  problem                Problem     @relation(fields: [problemId], references: [id])

  amount                 Decimal     @db.Decimal(12, 2)
  currency               String      @default("USD")
  state                  EscrowState @default(PENDING)

  // Generic provider ref — currently a Whop charge id, later a Stripe payment_intent id
  paymentProviderRef     String?
  paymentProviderType    String      @default("whop")

  heldAt                 DateTime?
  releasedAt             DateTime?
  refundedAt             DateTime?

  releasedToSubmissionId String?     @unique
  releasedToSubmission   Submission? @relation("EscrowRelease", fields: [releasedToSubmissionId], references: [id])

  createdAt              DateTime    @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([state])
}

// ─── Submissions ─────────────────────────────────────────────────────────

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Submission {
  id               String            @id @default(cuid())
  problemId        String
  problem          Problem           @relation(fields: [problemId], references: [id])
  solverId         String
  solver           User              @relation(fields: [solverId], references: [id])

  // The actual code lives in object storage, never in the DB directly
  codeBlobUrl      String
  // A redacted/masked preview the giver can see BEFORE paying — enough to judge intent, not enough to steal
  previewText      String            @db.Text

  status           SubmissionStatus  @default(SUBMITTED)
  submittedAt      DateTime          @default(now())

  // Reveal gate — this MUST only ever be set true by the server-side escrow release handler,
  // never set directly from client input. See src/lib/escrow/release.ts
  isRevealed       Boolean           @default(false)

  // Socket for future automated evaluation (LLM first-pass or sandbox judge).
  // v1: always null. v2: populated by src/lib/evaluation service.
  evaluationResult Json?

  escrowRelease    Escrow?           @relation("EscrowRelease")
  review           Review?

  @@index([problemId, status])
  @@index([solverId])
}

// ─── Reputation ──────────────────────────────────────────────────────────

model Badge {
  id        String      @id @default(cuid())
  name      String      @unique
  description String
  // e.g. { "type": "completions", "threshold": 100 } or { "type": "earned", "threshold": 1000 }
  criteria  Json
  iconUrl   String?

  users     UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
}

model Review {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id])

  fromUserId   String
  fromUser     User       @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User       @relation("ReviewsReceived", fields: [toUserId], references: [id])

  rating       Int        // 1-5
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())
}
</file>

