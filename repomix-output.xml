"use client";

import { Pill } from "./pill";
import {
  getLanguageLabel,
  LANGUAGE_SECTIONS,
  getLanguagesBySection,
  type LanguageDef,
} from "./flow-data";

export function getLanguageSummary(languageId: string): string {
  return getLanguageLabel(languageId);
}

