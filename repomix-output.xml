  return (
    <main className="px-8 py-10 max-w-2xl">
      <Link
        href={`/dashboard/giver/problems/${problem.id}`}
        className="inline-flex items-center gap-1.5 text-sm text-foreground-muted hover:text-foreground transition-colors mb-6"
