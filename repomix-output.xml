// Prisma schema for the bounty/challenge platform
// Connection URLs live in prisma.config.ts (Prisma 7+), not here.
// Run `npx prisma generate` then `npx prisma migrate dev --name init` after setting up .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core Users ──────────────────────────────────────────────────────────

enum UserRole {
  SOLVER
  GIVER
  BOTH
}

model User {
  // This id is NOT generated by Prisma — it must match Supabase Auth's
  // auth.users.id exactly (a UUID). Set explicitly when the row is created
  // by the auth sync step in src/lib/auth/sync-user.ts, never auto-generated.
  id               String   @id
  email            String   @unique
  role             UserRole?  // null until they complete onboarding
  name             String
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Verification — kept lightweight per product decision (bank + basic identity only)
  identityVerified Boolean  @default(false)

  // GitHub repo access (Solver side) — captured from the OAuth callback
  // when a solver logs in via GitHub with repo-read scope (see
  // src/app/auth/callback/route.ts). Used server-side ONLY, to clone a
  // submission's repo into the E2B sandbox — never sent to the client,
  // never exposed to the giver. A solver who signed up via email/Google
  // has no token here until they connect GitHub separately (see
  // githubConnected below). Same "real secret" handling as an API key —
  // v1 has no encryption-at-rest layer yet, see README.
  githubAccessToken String?
  githubConnected   Boolean  @default(false)
  githubUsername    String?  // GitHub login captured when a GIVER connects
                              // GitHub post-payment (see connect-github-prompt
                              // usage on the giver accept flow) OR when a
                              // solver connects (same field, either role).
                              // Needed because the collaborator-invite API
                              // takes a username, not a token — see
                              // lib/github/grant-access.ts. Once set, the
                              // giver never sees the "Connect GitHub" button
                              // again on any future accepted submission.

  // Payout pipeline (Solver side) — v1 is manual: solver submits bank
  // details directly (no external verification API), platform admin
  // transfers manually via Wise. See PayoutRequest for the 7-day queue.
  legalName         String?
  bankDetailsAdded  Boolean  @default(false)
  bankCountry       String?
  bankAccountNumber String?  // stored as given — v1 has no encryption-at-rest layer yet, see README
  bankIfscOrSwift   String?  // IFSC for India, SWIFT/BIC elsewhere

  // Credit wallet (Giver side)
  creditBalance      Decimal              @default(0) @db.Decimal(12, 2)
  creditTransactions CreditTransaction[]

  // Withdrawable balance (Solver side) — credited at 95% of bountyAmount when
  // a submission is accepted (platform's first 5% cut taken here, silently).
  // Separate from totalEarned, which is a lifetime stat and never decreases.
  // The second 5% cut is taken at withdrawal time, see PayoutRequest.
  availableBalance   Decimal              @default(0) @db.Decimal(12, 2)
  payoutRequests     PayoutRequest[]

  // Payment provider identity — generic so Whop -> Stripe swap doesn't touch schema
  paymentProviderId   String? // e.g. Whop user id now, Stripe customer id later
  paymentProviderType String  @default("whop") // "whop" | "stripe"

  // Reputation
  rating           Float    @default(0)
  totalEarned      Decimal  @default(0) @db.Decimal(12, 2)
  completionCount  Int      @default(0)
  accuracyRate     Float?   // nullable until they have enough completions to compute one

  // Relations
  problemsPosted   Problem[]      @relation("ProblemGiver")
  submissions      Submission[]
  badges           UserBadge[]
  reviewsGiven     Review[]       @relation("ReviewsGiven")
  reviewsReceived  Review[]       @relation("ReviewsReceived")

  @@index([email])
}

enum CreditTransactionType {
  PURCHASE
  BOUNTY_FUNDING
  SUBMISSION_REVIEW  // Added for $0.04 review charges
  REFUND
}

// ─── Platform fee model (product decision 2026-07-31) ───────────────────
// Giver side:  funding a bounty of $X debits $X * 1.10 from creditBalance.
//              Escrow always holds exactly $X (what solvers see/expect).
// Solver side: on acceptance, availableBalance += $X * 0.95 (first 5% cut,
//              taken silently at release — see lib/payments/fees.ts).
//              On withdrawal, the solver requests an amount from
//              availableBalance; the amount actually wired to their bank
//              is requested * 0.95 (second 5% cut, shown explicitly at
//              withdrawal time). Two separate 5% cuts, never combined into
//              one 10% deduction, so the solver only ever sees a small cut
//              at each step rather than one large one.

enum PayoutRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model CreditTransaction {
  id            String                  @id @default(cuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id])
  type          CreditTransactionType
  amount        Decimal                 @db.Decimal(12, 2)
  balanceAfter  Decimal                 @db.Decimal(12, 2)
  problemId     String?
  submissionId  String?                 // Relates transaction to a specific submission
  submission    Submission?             @relation(fields: [submissionId], references: [id])
  whopChargeRef String?
  createdAt     DateTime                @default(now())

  @@index([userId])
}

// Tracks a solver's request to withdraw from availableBalance to their bank.
// v1 is fully manual: requestedAmount leaves availableBalance immediately
// (see lib/payouts/withdraw.ts), the request becomes visible in the admin
// payout queue, and eligibleAt marks when the platform's 7-day payout
// window closes — the admin transfers the money by hand (Wise) any time
// at or after eligibleAt and marks the request SUCCEEDED.
model PayoutRequest {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])

  requestedAmount Decimal             @db.Decimal(12, 2)
  feeAmount       Decimal             @db.Decimal(12, 2)
  payoutAmount    Decimal             @db.Decimal(12, 2)

  // Snapshot of the bank details at request time, so a later profile edit
  // never changes where an already-queued payout gets sent.
  legalName         String
  bankCountry       String
  bankAccountNumber String
  bankIfscOrSwift   String

  status          PayoutRequestStatus @default(PENDING)
  eligibleAt      DateTime            // createdAt + 7 days, computed at creation

  createdAt       DateTime            @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([status])
}

// ─── Problems / Challenges ──────────────────────────────────────────────

enum ProblemType {
  OPEN_FREE       // no bounty, practice-only
  OPEN_BOUNTY     // open to all, bounty attached
  FIRST_TO_SOLVE  // paid only, but framed as a race — giver still picks best among submissions
  INVITE_ONLY     // giver invites specific solvers by rating/badge
  FIXED_PRICE     // enterprise — COMING SOON in v1, not enabled for creation
}

enum ProblemStatus {
  DRAFT       // being written, not yet funded
  FUNDED      // escrow funded, not yet visible/open
  OPEN        // visible, accepting submissions
  IN_REVIEW   // giver is reviewing submissions (open challenges can stay OPEN during review per product decision)
  COMPLETED   // a submission was accepted, escrow released
  CANCELLED   // giver cancelled before funding or before any submissions
  REFUNDED    // funded but cancelled/expired, escrow refunded
}

// v1 is Python-only by product decision (2026-08-03) — kept as a real enum
// rather than a free-text string so it's a type-level guarantee, not a
// convention. Adding a second language later is one enum value + one new
// E2B template, not a schema migration.
enum Runtime {
  PYTHON
}

model Problem {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  tags          String[]
  type          ProblemType
  status        ProblemStatus @default(DRAFT)

  bountyAmount  Decimal?      @db.Decimal(12, 2) // null for OPEN_FREE
  currency      String        @default("USD")

  // Execution contract — the giver defines exactly how their bounty gets
  // run in the sandbox. Solvers control only the code, never the command,
  // which is what makes the captured output trustworthy as an
  // anti-simulation guarantee (see lib/sandbox — a solver can't fake
  // output for a command they don't control).
  runtime       Runtime       @default(PYTHON)
  runCommand    String        // e.g. "python main.py"

  giverId       String
  giver         User          @relation("ProblemGiver", fields: [giverId], references: [id])

  escrow        Escrow?

  deadline      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  // INVITE_ONLY targeting — list of invited solver user ids
  inviteeIds    String[]      @default([])

  // Tracks free tier review allowance per-problem
  freeReviewsUsed Int         @default(0)

  submissions   Submission[]

  @@index([status, type])
  @@index([giverId])
}

// ─── Escrow — the trust core of the platform ────────────────────────────

enum EscrowState {
  PENDING    // created, awaiting payment capture
  HELD       // funds captured and held by platform
  RELEASED   // funds paid out to a solver
  REFUNDED   // funds returned to giver
  DISPUTED   // manual intervention needed
}

model Escrow {
  id                     String      @id @default(cuid())
  problemId              String      @unique
  problem                Problem     @relation(fields: [problemId], references: [id])

  amount                 Decimal     @db.Decimal(12, 2)
  currency               String      @default("USD")
  state                  EscrowState @default(PENDING)

  // Generic provider ref — currently a Whop charge id, later a Stripe payment_intent id
  paymentProviderRef     String?
  paymentProviderType    String      @default("whop")

  heldAt                 DateTime?
  releasedAt             DateTime?
  refundedAt             DateTime?

  releasedToSubmissionId String?     @unique
  releasedToSubmission   Submission? @relation("EscrowRelease", fields: [releasedToSubmissionId], references: [id])

  createdAt              DateTime    @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([state])
}

// ─── Submissions ─────────────────────────────────────────────────────────

enum SubmissionStatus {
  SUBMITTED
  RUNNING          // sandbox execution in progress
  AWAITING_REVIEW  // Mirrored & ready, awaiting giver action to execute sandbox
  SANDBOX_FAILED   // code didn't run at all (missing deps, crash, timeout) —
                   // distinct from a working solution the giver rejects,
                   // so a good solver's setup issue is never confused with
                   // a bad submission. Solver can resubmit.
  UNDER_REVIEW     // ran successfully, output captured, awaiting giver review
  ACCEPTED
  REJECTED
}

model Submission {
  id               String            @id @default(cuid())
  problemId        String
  problem          Problem           @relation(fields: [problemId], references: [id])
  solverId         String
  solver           User              @relation(fields: [solverId], references: [id])

  // GitHub repo URL only (product decision 2026-08-03) — no file/zip
  // upload, which avoids storage costs and a whole malicious-upload
  // surface area. The giver never gets clone access to the solver's own
  // repo at any point; they only ever receive the platform mirror below,
  // and only after escrow release.
  //
  // The SOLVER's original repo. Server-side only from here on — it is the
  // read source for the mirror below and is never shown to the giver, since
  // it identifies the solver's own account and may stay private forever.
  repoUrl          String

  // The platform's own copy of the submitted code, mirrored into
  // github.com/bountied-repositories at submission time by
  // src/lib/github/mirror.ts as a standalone repo (not a fork — a fork
  // stays linked to the solver's repo and can't be made private).
  //
  // This is the URL everything downstream uses: the sandbox clones it, and
  // it is the only repo URL the giver is ever shown. Null while the mirror
  // is still running, or if it failed (see sandboxError).
  platformRepoUrl      String?
  platformRepoFullName String?   // "bountied-repositories/sub-<id>" — for the visibility flip / cleanup

  // UNUSED as of 2026-08-09 — kept only so existing rows keep a value,
  // not read or written by any code path anymore. The mirror repo is now
  // PRIVATE FOREVER; access is granted per-giver via a collaborator invite
  // (see lib/github/grant-access.ts, called from lib/escrow/release.ts),
  // never by making the repo public. A public repo was a real
  // vulnerability: platformRepoFullName is derived from this submission's
  // own id, which is visible elsewhere in the app, so "public" meant
  // world-readable, not giver-readable. Safe to drop in a later migration
  // once confirmed nothing references it.
  platformRepoPublic   Boolean   @default(false)

  // Required "what I did" writeup — solver's own words, shown alongside
  // the sandbox output as part of the pre-payment preview.
  writeup          String            @db.Text

  // Real, captured sandbox execution output — this IS the anti-simulation
  // guarantee. Populated only by the server after E2B actually runs
  // Problem.runCommand against this submission's code; a solver never has
  // an opportunity to supply "logs" directly. Null until execution
  // completes (see status: RUNNING in the meantime).
  sandboxOutput    String?           @db.Text
  sandboxExitCode  Int?
  sandboxRanAt     DateTime?
  sandboxError     String?           // populated only when status = SANDBOX_FAILED

  status           SubmissionStatus  @default(SUBMITTED)
  submittedAt      DateTime          @default(now())

  // Reveal gate — this MUST only ever be set true by the server-side escrow release handler,
  // never set directly from client input. See src/lib/escrow/release.ts
  isRevealed       Boolean           @default(false)

  // Set once the giver has actually accepted a GitHub collaborator invite
  // to the platform mirror (see lib/github/grant-access.ts). Null means
  // either the invite hasn't been attempted yet, or it failed — most
  // commonly because the giver hadn't connected GitHub (no githubUsername
  // on their User row) at the moment they clicked Accept & pay. The giver
  // detail page offers a retry in that case.
  githubAccessGrantedAt DateTime?

  // Socket for future automated evaluation (LLM first-pass or sandbox judge).
  // v1: always null. v2: populated by src/lib/evaluation service.
  evaluationResult Json?

  escrowRelease    Escrow?           @relation("EscrowRelease")
  review           Review?
  creditTransactions CreditTransaction[]

  @@index([problemId, status])
  @@index([solverId])
}

// ─── Reputation ──────────────────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  // e.g. { "type": "completions", "threshold": 100 } or { "type": "earned", "threshold": 1000 }
  criteria    Json
  iconUrl     String?

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
}

model Review {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id])

  fromUserId   String
  fromUser     User       @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User       @relation("ReviewsReceived", fields: [toUserId], references: [id])

  rating       Int        // 1-5
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())
}
