# Copy to .env in this folder if needed. Never commit real values.

# Bountied website API the app talks to (example: local dev server).
# The Rust side reads this from the process environment (option_env! at build
# time, env::var at runtime), so for dev set it in the shell:
#   $env:BOUNTIED_API_URL = "http://localhost:3000"
BOUNTIED_API_URL=http://localhost:3000
