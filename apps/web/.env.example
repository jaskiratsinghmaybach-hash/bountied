# Copy to .env and fill in. Never commit real values.

# Database (Postgres via Supabase)
# Pooled connection used by the app at runtime
DATABASE_URL=
# Direct connection used by the Prisma CLI (migrate)
DIRECT_URL=

# Supabase auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: comma-separated admin emails
ADMIN_EMAILS=

# Whop payments
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=

# E2B sandbox
E2B_API_KEY=
SANDBOX_INTERNAL_SECRET=

# Platform GitHub account used to mirror accepted solutions
PLATFORM_GITHUB_TOKEN=
PLATFORM_GITHUB_OWNER=

# Gemini
GEMINI_API_KEY=

# Desktop device pairing: long random string, HMAC key for codes and tokens
DESKTOP_AUTH_SECRET=
