{
  "name": "bountied",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @bountied/web",
    "dev:desktop": "npm run tauri -w @bountied/desktop -- dev",
    "build:web": "npm run build -w @bountied/web",
    "build:desktop": "npm run tauri -w @bountied/desktop -- build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @bountied/web",
    "db:migrate": "npm run db:migrate -w @bountied/web"
  }
}
