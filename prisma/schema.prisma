generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id
  email               String              @unique
  name                String
  avatarUrl           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  identityVerified    Boolean             @default(false)
  paymentProviderId   String?
  paymentProviderType String              @default("whop")
  rating              Float               @default(0)
  totalEarned         Decimal             @default(0) @db.Decimal(12, 2)
  completionCount     Int                 @default(0)
  accuracyRate        Float?
  creditBalance       Decimal             @default(0) @db.Decimal(12, 2)
  legalName           String?
  role                UserRole?
  availableBalance    Decimal             @default(0) @db.Decimal(12, 2)
  bankDetailsAdded    Boolean             @default(false)
  bankCountry         String?
  bankAccountNumber   String?
  bankIfscOrSwift     String?
  githubAccessToken   String?
  githubConnected     Boolean             @default(false)
  githubUsername      String?
  creditTransactions  CreditTransaction[]
  payoutRequests      PayoutRequest[]
  problemsPosted      Problem[]           @relation("ProblemGiver")
  reviewsGiven        Review[]            @relation("ReviewsGiven")
  reviewsReceived     Review[]            @relation("ReviewsReceived")
  submissions         Submission[]
  badges              UserBadge[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent   Notification[]  @relation("NotificationSender")

  @@index([email])
}

model CreditTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          CreditTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  problemId     String?
  whopChargeRef String?
  createdAt     DateTime              @default(now())
  submissionId  String?
  submission    Submission?           @relation(fields: [submissionId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PayoutRequest {
  id                String              @id @default(cuid())
  userId            String
  requestedAmount   Decimal             @db.Decimal(12, 2)
  feeAmount         Decimal             @db.Decimal(12, 2)
  payoutAmount      Decimal             @db.Decimal(12, 2)
  status            PayoutRequestStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  legalName         String
  bankCountry       String
  bankAccountNumber String
  bankIfscOrSwift   String
  eligibleAt        DateTime
  user              User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Problem {
  id                String        @id @default(cuid())
  title             String
  description       String
  tags              String[]
  type              ProblemType
  status            ProblemStatus @default(DRAFT)
  bountyAmount      Decimal?      @db.Decimal(12, 2)
  currency          String        @default("USD")
  giverId           String
  deadline          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?
  inviteeIds        String[]      @default([])
  runtime           Runtime       @default(PYTHON)
  runCommand        String
  freeReviewsUsed   Int           @default(0)
  language          String?       @default("python")
  scope             String?
  addons            String[]      @default([])
  referenceRepoUrls String[]      @default([])
  screenshotUrls    String[]      @default([])
  logs              String?

  // Optional Solver-environment fence (product decision 2026-09-02) — set
  // by the Giver, defaults to null (fully open, zero extra friction for
  // the ~95% of Givers who never touch this). Constrains what packages a
  // Solver's requirements.txt may contain; never touches runCommand or
  // runtime, which stay the Giver's exclusive contract. Shape (validated
  // in lib/sandbox/bountied-manifest.ts, not enforced by Postgres):
  //   { maxDependencies?: number, allowedPackages?: string[], bannedPackages?: string[] }
  dependencyPolicy Json?

  escrow            Escrow?
  giver             User          @relation("ProblemGiver", fields: [giverId], references: [id])
  submissions       Submission[]

  @@index([status, type])
  @@index([giverId])
}

model Escrow {
  id                     String      @id @default(cuid())
  problemId              String      @unique
  amount                 Decimal     @db.Decimal(12, 2)
  currency               String      @default("USD")
  state                  EscrowState @default(PENDING)
  paymentProviderRef     String?
  paymentProviderType    String      @default("whop")
  heldAt                 DateTime?
  releasedAt             DateTime?
  refundedAt             DateTime?
  releasedToSubmissionId String?     @unique
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  problem                Problem     @relation(fields: [problemId], references: [id])
  releasedToSubmission   Submission? @relation("EscrowRelease", fields: [releasedToSubmissionId], references: [id])

  @@index([state])
}

model Submission {
  id                    String              @id @default(cuid())
  problemId             String
  solverId              String
  status                SubmissionStatus    @default(SUBMITTED)
  submittedAt           DateTime            @default(now())
  isRevealed            Boolean             @default(false)
  evaluationResult      Json?
  repoUrl               String
  writeup               String
  sandboxOutput         String?
  sandboxExitCode       Int?
  sandboxRanAt          DateTime?
  sandboxError          String?
  platformRepoFullName  String?
  platformRepoPublic    Boolean             @default(false)
  platformRepoUrl       String?
  githubAccessGrantedAt DateTime?
  creditTransactions    CreditTransaction[]
  escrowRelease         Escrow?             @relation("EscrowRelease")
  review                Review?
  problem               Problem             @relation(fields: [problemId], references: [id])
  solver                User                @relation(fields: [solverId], references: [id])
  notifications         Notification[]

  @@index([problemId, status])
  @@index([solverId])
}

/**
 * Two distinct kinds of notification share this one model on purpose,
 * distinguished by `senderId` rather than split into two tables — a
 * platform notification ("your payout is ready") and a Giver-to-solver
 * message about a specific submission (product decision 2026-09-29) are
 * both "something a User is told about," and the header bell
 * (header-notifications.tsx) needs to render both in one merged, sorted
 * feed regardless of source. senderId null = sent by the platform itself
 * (a system event, no human sender). senderId set = a real user (today,
 * always a Giver) sent it, and the UI should attribute it to them by name
 * rather than showing it as an anonymous platform message.
 *
 * Deliberately NOT a chat/thread model: a Giver can send a notification
 * about a submission, but a Solver cannot reply through this system (see
 * the Giver-notify UI's own doc comment for why — the product concern is
 * two parties negotiating a side deal off-platform to avoid the
 * platform's fee, which back-and-forth messaging enables in a way a
 * one-directional nudge doesn't).
 */
model Notification {
  id           String    @id @default(cuid())
  recipientId  String
  recipient    User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /** null = sent by the platform itself, not a human user. */
  senderId     String?
  sender       User?     @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  /** Optional link to the submission a Giver's notification is about — lets the notification deep-link back to the review page. Platform notifications (payouts, etc.) typically leave this null. */
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  body         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([submissionId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  criteria    Json
  iconUrl     String?
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model Review {
  id           String     @id @default(cuid())
  submissionId String     @unique
  fromUserId   String
  toUserId     String
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  fromUser     User       @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  submission   Submission @relation(fields: [submissionId], references: [id])
  toUser       User       @relation("ReviewsReceived", fields: [toUserId], references: [id])
}

enum UserRole {
  SOLVER
  GIVER
  BOTH
}

enum CreditTransactionType {
  PURCHASE
  BOUNTY_FUNDING
  REFUND
  SUBMISSION_REVIEW
}

enum PayoutRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ProblemType {
  OPEN_FREE
  OPEN_BOUNTY
  FIRST_TO_SOLVE
  INVITE_ONLY
  FIXED_PRICE
}

enum ProblemStatus {
  DRAFT
  FUNDED
  OPEN
  IN_REVIEW
  COMPLETED
  CANCELLED
  REFUNDED
}

enum Runtime {
  PYTHON
  NODE
}

enum EscrowState {
  PENDING
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  RUNNING
  SANDBOX_FAILED
  AWAITING_REVIEW

  // Added (product decision 2026-09-02) — see Problem.dependencyPolicy doc
  // comment above and lib/sandbox/bountied-manifest.ts. Splits what used
  // to be one opaque SANDBOX_FAILED bucket into cases a giver can actually
  // tell apart when reviewing a failed submission.
  DEPENDENCY_POLICY_VIOLATION
  DEPENDENCY_INSTALL_FAILED

  // Added (product decision 2026-09-28). RUNNING previously covered two
  // unrelated things: mirroring a solver's repo right after submission
  // (free, automatic, seconds long) and actually running the paid E2B
  // sandbox (only after the Giver clicks "Run sandbox review" — see
  // review-button.tsx). Sharing one status meant the review card showed
  // "Running sandbox" — with the same green styling a real paid run
  // gets — during the free mirror step, before the Giver had clicked
  // anything. MIRRORING is that free step; RUNNING now means only the
  // paid sandbox execution in api/sandbox/run/route.ts.
  MIRRORING
}
